{
  "manifest_version": 3,
  "name": "SmartIT – Exportar incidencia",
  "version": "0.5.1",
  "description": "Uso personal. Exporta una incidencia de BMC Helix SmartIT a un visor local: todo el texto listo para copiar y los adjuntos sin descargarlos. Solo lectura.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://*.onbmc.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.onbmc.com/smartit/app/*"],
      "js": ["top.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.onbmc.com/arsys/pwa/*"],
      "js": ["main-hook.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.onbmc.com/arsys/pwa/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
