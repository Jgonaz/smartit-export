{
  "manifest_version": 3,
  "name": "SmartIT – Exportar incidencia",
  "version": "0.14.0",
  "description": "Uso personal. Exporta una incidencia de BMC Helix SmartIT a un visor local: todo el texto listo para copiar y los adjuntos sin descargarlos. Solo lectura.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.onbmc.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.onbmc.com/smartit/app/*"
      ],
      "js": [
        "top.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.onbmc.com/arsys/pwa/*"
      ],
      "js": [
        "main-hook.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.onbmc.com/arsys/pwa/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.js",
        "viewer.css",
        "theme.js",
        "carpeta.js",
        "fonts/*"
      ],
      "matches": [
        "https://*.onbmc.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
